# Acttus OS — variáveis de ambiente (configure na Vercel → Settings → Environment Variables)
# NUNCA comite valores reais. O .env / .env.local estão no .gitignore.

# Banco (Neon) — preenchido automaticamente ao criar o banco na Vercel (Storage → Create Database → Neon)
DATABASE_URL=

# Segredo para assinar os tokens de login (gere um valor aleatório longo)
APP_SECRET=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.ordem.app.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_GROUP_ID=120363428042165535@g.us

# Protege o endpoint de cron (gere um valor aleatório). O Vercel Cron envia este valor automaticamente.
CRON_SECRET=

# Link de agendamento enviado no aviso de novo onboarding (webhook do GHL).
# Opcional: se ficar vazio, usa o mesmo link das gravações.
CALENDLY_ONBOARDING_URL=https://calendly.com/contato-acttusco/gravacao
